# ERPSEED Backend
ERPSEED_AGENT_ERPSEED_BASE_URL=http://localhost:5000
ERPSEED_AGENT_ERPSEED_SERVICE_JWT=

# Nostr / Relay
ERPSEED_AGENT_NOSTR_RELAY_URL=wss://relay.damus.io
ERPSEED_AGENT_NOSTR_PRIVATE_KEY=nsec1...

# IPFS / Vault
ERPSEED_AGENT_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
