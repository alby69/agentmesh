ERPSEED_AGENT_IPFS_PINNING_SERVICE=

# LLM Configuration
ERPSEED_AGENT_LLM_PROVIDER=openai
ERPSEED_AGENT_LLM_API_KEY=sk-...
ERPSEED_AGENT_LLM_MODEL=gpt-4o-mini

# Web Server & Sync
ERPSEED_AGENT_WEB_HOST=0.0.0.0
ERPSEED_AGENT_WEB_PORT=8000
ERPSEED_AGENT_SYNC_INTERVAL_SECONDS=60
