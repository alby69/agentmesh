# Newsletter Filter - Configurazione
# Copia questo file in .env e compila i valori

# --- LLM ---
FILTER_LLM_PROVIDER=openai
FILTER_LLM_API_KEY=sk-your-api-key-here
FILTER_LLM_MODEL=gpt-4o-mini

# --- RSS (comma-separated URLs) ---
FILTER_RSS_URLS=["https://stefanogatti.substack.com/feed"]

# --- Substack archive (0 = all posts) ---
FILTER_SUBSTACK_LIMIT=0
FILTER_SUBSTACK_OFFSET=0

# --- IMAP (per newsletter via email) ---
FILTER_IMAP_HOST=imap.gmail.com
FILTER_IMAP_USER=your-email@gmail.com
FILTER_IMAP_PASSWORD=your-app-password
FILTER_IMAP_FOLDER=INBOX

# --- Query semantica predefinita ---
FILTER_DEFAULT_QUERY=Risorse Umane e Intelligenza Artificiale, impatto dell'AI sul lavoro e HR
